    },
    "binary_sensor": {
      "all_done": {
        "default": "mdi:trophy-outline",
        "state": { "on": "mdi:trophy" }
      }
    },
    "todo": {
      "today": { "default": "mdi:clipboard-text" }
    },
    "event": {
