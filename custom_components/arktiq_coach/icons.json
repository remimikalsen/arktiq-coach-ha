    "sensor": {
      "tasks_done": { "default": "mdi:check-circle" },
      "tasks_total": { "default": "mdi:format-list-checks" },
      "tasks_remaining": { "default": "mdi:progress-clock" },
      "completion": { "default": "mdi:percent" },
      "streak": { "default": "mdi:fire" },
      "badge_count": { "default": "mdi:medal" },
      "last_badge": { "default": "mdi:medal-outline" },
